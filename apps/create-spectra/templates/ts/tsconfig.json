{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Spectra provides web-platform globals (fetch, URL, EventTarget, WebSocket, ...) and Node builtins.
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    // Generated Java declarations contain Java-isms (covariant overrides) TypeScript cannot express exactly.
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // .spectra/types/server.d.ts is generated by the Spectra plugin for your server (run `npm run dev` once).
  "include": ["src", ".spectra/**/*.d.ts"]
}
