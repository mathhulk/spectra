{
  "schemaVersion": 1,
  "id": "spectra",
  "version": "${version}",
  "name": "Spectra",
  "description": "Renders server-driven web UIs (screens and HUD layers) for servers running Spectra.",
  "authors": ["mathhulk"],
  "contact": {
    "homepage": "https://mathhulk.github.io/spectra",
    "sources": "https://github.com/mathhulk/spectra",
    "issues": "https://github.com/mathhulk/spectra/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/spectra/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.mathhulk.spectra.fabric.SpectraClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "rinku": ">=3.0.5"
  }
}
